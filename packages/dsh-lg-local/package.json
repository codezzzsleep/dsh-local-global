{
  "name": "@local-global/dsh-lg-local",
  "version": "0.0.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./evidence": {
      "types": "./lib/evidence.d.ts",
      "default": "./lib/evidence.js"
    },
    "./package.json": "./package.json",
    "./patch": {
      "types": "./lib/patch.d.ts",
      "default": "./lib/patch.js"
    },
    "./report-gate": {
      "types": "./lib/report-gate.d.ts",
      "default": "./lib/report-gate.js"
    },
    "./action-gate": {
      "types": "./lib/action-gate.d.ts",
      "default": "./lib/action-gate.js"
    },
    "./protect": {
      "types": "./lib/protect.d.ts",
      "default": "./lib/protect.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@local-global/lg-protocol": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "Local–Global Local-side plugins for DeepSeek Harness.",
  "license": "MIT",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  }
}
